# Set default behavior to automatically normalize line endings for text files
* text=auto eol=lf

# Explicitly enforce LF for Docker and container configuration files
Dockerfile* text eol=lf
*.dockerfile text eol=lf
.dockerignore text eol=lf
docker-compose*.yml text eol=lf
docker-compose*.yaml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Enforce LF for shell scripts and Linux config files (critical for container entrypoints)
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.conf text eol=lf
*.env* text eol=lf

# Enforce LF for Go and Node.js project files
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf

# Keep CRLF for Windows-specific scripts if you ever use them
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Denote binary files so Git does not attempt to modify them
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.gz binary
*.tar binary
*.zip binary